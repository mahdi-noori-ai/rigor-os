# Copy to the project root as .env — never commit the real file.
COMPOSE_PROJECT_NAME=app

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# Route the API through PgBouncer (docker compose --profile pooler up):
# DB_HOST=pgbouncer
# DB_PORT=5432

HTTP_PORT=8080

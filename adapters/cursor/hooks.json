{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard_shell.py",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/remind-verification.sh",
        "timeout": 5
      }
    ]
  }
}

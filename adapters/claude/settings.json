{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(terraform destroy *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.prod*)",
      "Read(.env.staging*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker compose down *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(uv add *)",
      "Bash(pip install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_shell.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
